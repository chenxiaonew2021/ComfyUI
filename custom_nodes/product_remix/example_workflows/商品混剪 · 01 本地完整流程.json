        "{\n  \"project_name\": \"商品混剪流程 · 本地素材演示\",\n  \"product\": {\n    \"id\": \"local-demo\",\n    \"name\": \"小猫的三段旅程\",\n    \"selling_points\": [\n      \"院子探索\",\n      \"室内陪伴\",\n      \"梦境冒险\"\n    ],\n    \"audiences\": [\n      \"喜欢猫咪生活故事的观众\"\n    ],\n    \"tags\": [\n      \"小猫\",\n      \"梦境\"\n    ]\n  },\n  \"video\": {\n    \"resolution\": \"720x1280\",\n    \"fps\": 30,\n    \"fit\": \"pad\"\n  },\n  \"policy\": {\n    \"creative_recall\": true,\n    \"cover\": true,\n    \"aigc\": false,\n    \"super_resolution\": false\n  },\n  \"materials\": [\n    {\n      \"id\": \"courtyard\",\n      \"file\": \"remix/e2e/footage/courtyard.mp4\",\n      \"in\": 0.1,\n      \"out\": 4.3,\n      \"tags\": [\n        \"小猫\",\n        \"院子探索\"\n      ],\n      \"description\": \"项目已有院子小猫视频\",\n      \"narration\": \"小猫走进院子。\"\n    },\n    {\n      \"id\": \"indoor\",\n      \"file\": \"remix/e2e/footage/indoor.mp4\",\n      \"in\": 0.1,\n      \"out\": 4.3,\n      \"tags\": [\n        \"小猫\",\n        \"室内陪伴\"\n      ],\n      \"description\": \"项目已有室内小猫视频\",\n      \"narration\": \"换个角落，继续探索。\"\n    },\n    {\n      \"id\": \"dream\",\n      \"file\": \"remix/e2e/footage/dream.mp4\",\n      \"in\": 0.1,\n      \"out\": 4.3,\n      \"tags\": [\n        \"小猫\",\n        \"梦境冒险\"\n      ],\n      \"description\": \"项目已有云端梦境视频\",\n      \"narration\": \"梦里也有新风景。\"\n    }\n  ],\n  \"creative_library\": [\n    {\n      \"id\": \"three-scenes\",\n      \"tags\": [\n        \"小猫\",\n        \"室内陪伴\"\n      ],\n      \"structure\": \"探索开场 → 陪伴展开 → 梦境收束\"\n    }\n  ],\n  \"voice\": {\n    \"name\": \"Tingting\",\n    \"rate\": 200\n  },\n  \"cover_seconds\": 0.6,\n  \"bgm\": {\n    \"file\": \"remix-demo-bgm.wav\",\n    \"db\": -22,\n    \"duck\": true\n  },\n  \"assets\": {},\n  \"note\": \"仅以已有猫咪素材验证业务阶段和媒体链路，不代表真实商品广告或自动视觉理解结果。\"\n}"
